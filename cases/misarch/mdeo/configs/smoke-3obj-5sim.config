// Calibration of today-3obj-5sim.config: the same seed, goal, search and population (175), 3 generations, for its
// time per generation.

problem {
    metamodel = "../../metamodel/domain.mm"
    model = "../../models/domain-today-realised.m"
}

goal {
    import { cost, failure, performance, latencyBudget, peakCapacity, cohesion, changeCouplingBound, inconsistencyBound } from "../../transform/metrics.fn"

    minimize cost
    minimize failure
    minimize performance
    constraint latencyBudget
    constraint peakCapacity
    constraint cohesion
    constraint changeCouplingBound
    constraint inconsistencyBound
}

search {
    mutations {
        using "../realised/move-component.mt"
        using "../realised/move-to-callee.mt"
        using "../realised/move-to-caller.mt"
        using "../realised/swap-components.mt"
        using "../realised/merge-containers.mt"
        using "../realised/split-component.mt"
        using "../realised/consolidate-servers.mt"
        using "../realised/change-mechanism.mt"
        using "../realised/change-coordination.mt"
        using "../realised/change-home.mt"
        using "./change-workflow-mechanisms.mt"
        using "./change-pair-mechanisms.mt"
        using "./change-class-mechanisms.mt"
        using "./change-operation-mechanisms.mt"
        using "./move-group.mt"
        using "./split-region.mt"
        using "./swap-groups.mt"
        using "./move-unit.mt"
        using "./gather-unit.mt"
    }
    crossovers {
        using "../crossover/take-service.mt"
        using "../crossover/take-mechanisms.mt"
        using "../crossover/take-workflow.mt"
        using "../crossover/take-home.mt"
        using "../crossover/agree-colocation.mt"
    }
}

solver {
    algorithm = NSGAII

    parameters {
        population = 175
        variation = genetic

        crossover {
            rate = 0.9
            parents = 2
            strategy = random
        }

        mutation {
            step = interval(1, 4)
            strategy = random
        }
    }

    termination {
        evolutions = 3
        time = 3600
    }

    batches = 1
}

runtime {
    timeout {
        script = 600
        transformation = 30
    }
}
