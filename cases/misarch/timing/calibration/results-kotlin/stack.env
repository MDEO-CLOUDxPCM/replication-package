# JVM heap settings for the misarch-kotlin stack during calibration (source before deploy/compose/up.sh; compose
# recreates the affected containers when they change). Pinned on 2026-10-14 so results do not depend on host RAM:
#  - Kotlin apps: without -Xmx the JVM takes 1/4 of host RAM (8 GB on the 31-GB VM); a saturated catalog filled it with
#    queued work. -Xms512m = the former default on the 31-GB VM (1/64 of RAM).
#  - Keycloak 23: built-in -Xmx512m holds ~150k user sessions (one per password grant, 3600 s SSO idle), i.e. ~40
#    logins/s sustained over the trailing hour; above that Keycloak thrashes in full GCs. 2 GB holds ~580k.
export MISARCH_JAVA_OPTS="-Xms512m -Xmx2g"
export MISARCH_KEYCLOAK_JAVA_OPTS="-Xmx2g"
