# Machine-specific settings of the timing campaign. Copy to local.env (not in git); timing-up.sh reads it.
# Directory of async-profiler 4.2.1 (bin/asprof, lib/libasyncProfiler.so), mounted read-only into the timing images.
TIMING_ASPROF_DIR=/path/to/async-profiler-4.2.1
# Checkout of misarch-kotlin; default: the submodule misarch-kotlin/ of this repository, else ../misarch-kotlin beside it.
#MISARCH_KOTLIN_REPO=/path/to/misarch-kotlin
