using "../../metamodel/architecture.mm"
import "../pinned/blocks-stale.mt" as pinnedRemoveStaleBlocks
import "./changed-call.mt" as repairChangedCall

// The layer-2 repair of one call whose mechanism changed and nothing else (DESIGN.md B4.5), after
// its plan (./call-site.mt): only when its blocks are stale or its structure differs from its plan, the rest of
// the statements of the whole realisation about it (./changed-call.mt). Statements pinned to the
// call are generated by core/tools/pin.py into ../pinned/. Not for a change to or from a LocalCopy
// (layer 3 then changes redirects, copy stores and deliveries: ./site.mt).
in rc: RealisedCall

if match {
    rc { }
    rsBlock: MiddlewareBlock { }
    rsBlock.realised -- rc
    where rsBlock.kind != rc.kind || rsBlock.shape != rc.shape
} then {
    call pinnedRemoveStaleBlocks(pc = rc)
    call repairChangedCall(rc = rc)
} else {
    if match {
        rc { }
        where rc.built != rc.shape
    } then {
        call repairChangedCall(rc = rc)
    }
}
