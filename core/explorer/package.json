{
  "name": "domain-cut-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "contract:schema": "tsx contract/gen-schema.ts",
    "postinstall": "node tools/link-packets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "export:run": "node tools/link-packets.mjs && tsx ../../cases/misarch/explorer-packet/export-run.ts",
    "export:model": "node tools/link-packets.mjs && tsx ../../cases/misarch/explorer-packet/export-model.ts",
    "packet:misarch": "node tools/link-packets.mjs && tsx ../../cases/misarch/explorer-packet/build.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "echarts": "5.6.0",
    "elkjs": "0.11.1",
    "hono": "^4.13.13",
    "jspdf": "^3.0.4",
    "katex": "0.16.22",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "orthoflow": "0.1.0",
    "radix-ui": "^1.8.1",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-resizable-panels": "^4.14.5",
    "react-router": "7.18.4",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "svg2pdf.js": "^2.8.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.18",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
